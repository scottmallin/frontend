# This repository uses ONLY the public npm registry.
# No private/internal package feeds or credentials are configured here.
auto-install-peers=true

# Volta installs pnpm as the standalone @pnpm/exe binary (its own bundled Node), which
# does NOT put a real `node` on the PATH it hands to lifecycle/`exec` scripts — so
# `turbo run build`, `prepack`, etc. fail with "'node' is not recognized". Pinning the
# Node version here makes pnpm provide Node to those child scripts. Keep this in sync with
# the `volta.node` pin in package.json.
use-node-version=26.5.0
