{
  "name": "@scottmallin/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 SFC wrappers around the core primitives. Props are typed from the registry; styling is token-backed Tailwind utilities only — no hardcoded values.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "files": ["src"],
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@scottmallin/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.0.0"
  }
}
